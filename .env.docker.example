# ==============================================================================
# BookLeaf AuthorDesk — Docker Compose Environment Variables
# Copy this file to .env.docker before running Docker Compose:
#   cp .env.docker.example .env.docker
#
# To start the containers using this file:
#   docker compose --env-file .env.docker up -d
# ==============================================================================

# --- MySQL Service Configuration ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=bookleaf_authordesk
MYSQL_USER=bookleaf_user
MYSQL_PASSWORD=change_this_user_password

# --- Backend Application Configuration ---
NODE_ENV=production
PORT=5000

# Browser-facing frontend origin (must match where the user accesses the UI)
CLIENT_URL=http://localhost:8080

# JSON Web Token Secret
# Generate a strong 64-char secret: openssl rand -base64 48
JWT_SECRET=replace_with_a_secure_random_64_character_secret_key
JWT_EXPIRES_IN=1d

# Google Gemini API (leave blank if testing without AI draft generation)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
