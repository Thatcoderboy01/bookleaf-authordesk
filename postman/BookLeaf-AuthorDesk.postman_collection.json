{
  "info": {
    "_postman_id": "b1a2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
    "name": "BookLeaf AuthorDesk API",
    "description": "Comprehensive API collection for testing BookLeaf AuthorDesk, covering authentication, author catalog, royalties, support tickets, admin triage, and grounded AI drafts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Public health check endpoint verifying server status and environment."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var response = pm.response.json();",
                  "if (response.success && response.data && response.data.accessToken) {",
                  "    pm.environment.set(\"adminToken\", response.data.accessToken);",
                  "    console.log(\"Saved adminToken successfully.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@bookleaf.demo\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates as the demo admin account and saves the access token to {{adminToken}}."
          },
          "response": []
        },
        {
          "name": "Login as Author",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var response = pm.response.json();",
                  "if (response.success && response.data && response.data.accessToken) {",
                  "    pm.environment.set(\"authorToken\", response.data.accessToken);",
                  "    console.log(\"Saved authorToken successfully.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya.sharma@email.com\",\n  \"password\": \"Demo@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates as a seeded demo author and saves the access token to {{authorToken}}."
          },
          "response": []
        },
        {
          "name": "Register New Author",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Author\",\n  \"email\": \"test.author@example.com\",\n  \"password\": \"AuthorPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new author account with role AUTHOR."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Author Books",
      "item": [
        {
          "name": "List Author Books",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var response = pm.response.json();",
                  "if (response.success && Array.isArray(response.data) && response.data.length > 0) {",
                  "    pm.environment.set(\"bookId\", response.data[0].id);",
                  "    console.log(\"Saved first bookId: \" + response.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Lists books belonging to the authenticated author and captures the first bookId into the environment."
          },
          "response": []
        },
        {
          "name": "Get Book Details by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}"]
            },
            "description": "Retrieves publication details and royalty performance for a specific book."
          },
          "response": []
        },
        {
          "name": "List All Books (Admin View)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Lists all books across the catalog when accessed by an administrator."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Royalties",
      "item": [
        {
          "name": "Get Royalty Records (Author)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/royalties",
              "host": ["{{baseUrl}}"],
              "path": ["royalties"]
            },
            "description": "Lists granular quarterly royalty records for the authenticated author."
          },
          "response": []
        },
        {
          "name": "Get Royalty Summary (Author)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/royalties/summary",
              "host": ["{{baseUrl}}"],
              "path": ["royalties", "summary"]
            },
            "description": "Returns calculated earnings summary: totalEarned, totalPaid, and totalPending."
          },
          "response": []
        }
      ]
